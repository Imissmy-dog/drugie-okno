<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="650"
        Width="750" Height="620"
        WindowStartupLocation="CenterScreen"
        x:Class="okno.MainWindow"
        Title="Cat of many names"
        RequestedThemeVariant="Default"
        Background="{DynamicResource WindowBgBrush}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <!-- Motyw jasny (Light) bazowany na 4 barwach -->
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="WindowBgBrush" Color="#F5F0E6" />
                    <SolidColorBrush x:Key="BannerBgBrush" Color="#7F8C6A" />
                    <SolidColorBrush x:Key="BannerTextBrush" Color="#1E3B2F" />
                    <SolidColorBrush x:Key="H1Brush" Color="#1E3B2F" />
                    <SolidColorBrush x:Key="H2Brush" Color="#7F8C6A" />
                    <SolidColorBrush x:Key="BodyTextBrush" Color="#1E3B2F" />
                    <SolidColorBrush x:Key="CardBgBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="CardBorderBrush" Color="#C8B48A" />
                    <SolidColorBrush x:Key="FooterBgBrush" Color="#F5F0E6" />
                    <SolidColorBrush x:Key="FooterBorderBrush" Color="#C8B48A" />
                    <SolidColorBrush x:Key="FooterTextBrush" Color="#7F8C6A" />
                </ResourceDictionary>

                <!-- Opcjonalny motyw ciemny (Dark) o podobnych ale znacznie ciemniejszych barwach -->
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="WindowBgBrush" Color="#0E1813" />
                    <SolidColorBrush x:Key="BannerBgBrush" Color="#1A2E24" />
                    <SolidColorBrush x:Key="BannerTextBrush" Color="#8FA37E" />
                    <SolidColorBrush x:Key="H1Brush" Color="#F5F0E6" />
                    <SolidColorBrush x:Key="H2Brush" Color="#C8B48A" />
                    <SolidColorBrush x:Key="BodyTextBrush" Color="#E0D8CB" />
                    <SolidColorBrush x:Key="CardBgBrush" Color="#15231C" />
                    <SolidColorBrush x:Key="CardBorderBrush" Color="#5A503C" />
                    <SolidColorBrush x:Key="FooterBgBrush" Color="#0A130F" />
                    <SolidColorBrush x:Key="FooterBorderBrush" Color="#223328" />
                    <SolidColorBrush x:Key="FooterTextBrush" Color="#7F8C6A" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid RowDefinitions="Auto, *, Auto">
        <!-- Baner na samej górze ekranu -->
        <Border Grid.Row="0"
                Background="{DynamicResource BannerBgBrush}"
                Padding="16,12">
            <TextBlock Text="cats of the wild"
                       Foreground="{DynamicResource BannerTextBrush}"
                       FontSize="16"
                       FontWeight="Medium"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center" />
        </Border>

        <!-- Główna zawartość okna -->
        <ScrollViewer Grid.Row="1" Margin="24,18">
            <StackPanel Spacing="14" MaxWidth="680" HorizontalAlignment="Center">
                <TextBlock Text="Puma concolor"
                           FontSize="32"
                           FontWeight="Bold"
                           Foreground="{DynamicResource H1Brush}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Cat of many names"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource H2Brush}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="The puma (Puma concolor) holds a record for having over 40 English names—and over 200 names globally—because of its massive geographic range across the Americas. Here are the best known few:"
                           FontSize="15"
                           Foreground="{DynamicResource BodyTextBrush}"
                           TextWrapping="Wrap"
                           Margin="0,6,0,6" />

                <!-- Karta z listą nazw -->
                <Border Background="{DynamicResource CardBgBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1.5"
                        CornerRadius="10"
                        Padding="18,14">
                    <StackPanel Spacing="10">
                        <TextBlock Text="• Puma (widely used in Latin America, Europe, and scientific literature)"
                                   Foreground="{DynamicResource BodyTextBrush}"
                                   TextWrapping="Wrap"
                                   FontSize="14" />
                        <TextBlock Text="• Mountain lion (commonly used in the western and general United States)"
                                   Foreground="{DynamicResource BodyTextBrush}"
                                   TextWrapping="Wrap"
                                   FontSize="14" />
                        <TextBlock Text="• Cougar (commonly used in Canada and parts of North America)"
                                   Foreground="{DynamicResource BodyTextBrush}"
                                   TextWrapping="Wrap"
                                   FontSize="14" />
                        <TextBlock Text="• Catamount / Cat-o'-mountain (shortened from &quot;cat of the mountain,&quot; used in New England and historically)"
                                   Foreground="{DynamicResource BodyTextBrush}"
                                   TextWrapping="Wrap"
                                   FontSize="14" />
                        <TextBlock Text="• Panther / Florida panther (especially used in Florida and the southeastern U.S.)"
                                   Foreground="{DynamicResource BodyTextBrush}"
                                   TextWrapping="Wrap"
                                   FontSize="14" />
                    </StackPanel>
                </Border>

                <!-- Zdjęcie pumy pod całym tekstem -->
                <Border CornerRadius="10"
                        ClipToBounds="True"
                        Margin="0,10,0,10">
                    <Image Source="avares://okno/pumadaytime.jpg"
                           MaxWidth="680"
                           MaxHeight="380"
                           Stretch="Uniform" />
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Stopka (footer) na dole ekranu -->
        <Border Grid.Row="2"
                Background="{DynamicResource FooterBgBrush}"
                BorderBrush="{DynamicResource FooterBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="14,10">
            <TextBlock Text="Information is taken from the official English Wikipedia page for Puma concolor."
                       FontSize="12"
                       FontStyle="Italic"
                       Foreground="{DynamicResource FooterTextBrush}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
        </Border>
    </Grid>
</Window>
