<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="560"
        Width="750" Height="540"
        WindowStartupLocation="CenterScreen"
        x:Class="okno.MainWindow"
        Title="Cat of many names"
        Background="#F5F0E6">
    <Grid RowDefinitions="Auto, *, Auto">
        <!-- Baner na samej górze ekranu: tło szałwiowe (#7F8C6A), tekst w ciemniejszej leśnej zieleni (#1E3B2F) -->
        <Border Grid.Row="0"
                Background="#7F8C6A"
                Padding="16,12">
            <TextBlock Text="cats of the wild"
                       Foreground="#1E3B2F"
                       FontSize="16"
                       FontWeight="Medium"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center" />
        </Border>

        <!-- Główna zawartość okna -->
        <ScrollViewer Grid.Row="1" Margin="24,18">
            <StackPanel Spacing="14" MaxWidth="680" HorizontalAlignment="Center">
                <TextBlock Text="Puma concolor"
                           FontSize="32"
                           FontWeight="Bold"
                           Foreground="#1E3B2F"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Cat of many names"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="#7F8C6A"
                           HorizontalAlignment="Center" />
                <TextBlock Text="The puma (Puma concolor) holds a record for having over 40 English names—and over 200 names globally—because of its massive geographic range across the Americas. Here are the best known few:"
                           FontSize="15"
                           Foreground="#1E3B2F"
                           TextWrapping="Wrap"
                           Margin="0,6,0,6" />

                <!-- Karta z listą nazw: ciepła piaskowa ramka (#C8B48A) -->
                <Border Background="#FFFFFF"
                        BorderBrush="#C8B48A"
                        BorderThickness="1.5"
                        CornerRadius="10"
                        Padding="18,14">
                    <StackPanel Spacing="10">
                        <TextBlock Text="• Puma (widely used in Latin America, Europe, and scientific literature)"
                                   Foreground="#1E3B2F"
                                   TextWrapping="Wrap"
                                   FontSize="14" />
                        <TextBlock Text="• Mountain lion (commonly used in the western and general United States)"
                                   Foreground="#1E3B2F"
                                   TextWrapping="Wrap"
                                   FontSize="14" />
                        <TextBlock Text="• Cougar (commonly used in Canada and parts of North America)"
                                   Foreground="#1E3B2F"
                                   TextWrapping="Wrap"
                                   FontSize="14" />
                        <TextBlock Text="• Catamount / Cat-o'-mountain (shortened from &quot;cat of the mountain,&quot; used in New England and historically)"
                                   Foreground="#1E3B2F"
                                   TextWrapping="Wrap"
                                   FontSize="14" />
                        <TextBlock Text="• Panther / Florida panther (especially used in Florida and the southeastern U.S.)"
                                   Foreground="#1E3B2F"
                                   TextWrapping="Wrap"
                                   FontSize="14" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Stopka (footer) na dole ekranu -->
        <Border Grid.Row="2"
                Background="#F5F0E6"
                BorderBrush="#C8B48A"
                BorderThickness="0,1,0,0"
                Padding="14,10">
            <TextBlock Text="Information is taken from the official English Wikipedia page for Puma concolor."
                       FontSize="12"
                       FontStyle="Italic"
                       Foreground="#7F8C6A"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
        </Border>
    </Grid>
</Window>
